+    const { canvas } = mount({ editSession: s, activeTool: { kind: "pencil", stamp: STAMP } });
+    fireEvent.mouseDown(canvas, at(0, 0));
+    await waitFor(() => expect(log).toEqual(["begin", "apply 0"]));
+    fireEvent.mouseDown(canvas, at(1, 0)); // no mouseup in between
+    await act(async () => {});
+    expect(log).toEqual(["begin", "apply 0", "end"]);
+    await act(async () => end.resolve());
+    await waitFor(() => expect(log).toEqual(["begin", "apply 0", "end", "begin", "apply 1"]));
+  });
+
+  for (const phase of ["begin", "apply"] as const) it.each(["map", "ABA", "unmount"])("%s retires pending " + phase + " and still finishes its issued begin", async (retirement) => {
+    const pending = held();
+    const old = session(phase === "begin" ? { beginStroke: vi.fn(() => pending.promise) } : { applyPaint: vi.fn(() => pending.promise) });
+    const next = session();
+    const props = { activeTool: { kind: "pencil" as const, stamp: STAMP } };
+    const mounted = mount({ ...props, editSession: old });
+    fireEvent.mouseDown(mounted.canvas, at(0, 0));
+    await waitFor(() => expect(old.beginStroke).toHaveBeenCalledTimes(1));
+    if (phase === "apply") await waitFor(() => expect(old.applyPaint).toHaveBeenCalledTimes(1));
+    fireEvent.mouseMove(mounted.canvas, { ...at(1, 0), buttons: 1 });
+    if (retirement === "unmount") mounted.unmount();
+    else {
+      rerenderAs(mounted, "Bar", { ...props, editSession: next });
+      if (retirement === "ABA") rerenderAs(mounted, "Foo", { ...props, editSession: next });
+      fireEvent.mouseUp(mounted.canvas, at(1, 0));
+    }
+    await act(async () => pending.resolve());
+    expect(old.applyPaint).toHaveBeenCalledTimes(phase === "begin" ? 0 : 1);
+    expect(old.endStroke).toHaveBeenCalledTimes(1); // only the captured old session finishes, never the new map's
+    expect(next.beginStroke).not.toHaveBeenCalled();
+    expect(next.applyPaint).not.toHaveBeenCalled();
+    expect(next.endStroke).not.toHaveBeenCalled();
+  });
+
+  it("a retired held end is not followed by new work on the next visit's session", async () => {
+    const end = held();
+    const old = session({ endStroke: vi.fn(() => end.promise) });
+    const next = session();
+    const props = { activeTool: { kind: "pencil" as const, stamp: STAMP } };
+    const mounted = mount({ ...props, editSession: old });
+    fireEvent.mouseDown(mounted.canvas, at(0, 0));
+    fireEvent.mouseUp(mounted.canvas, at(0, 0));
+    await waitFor(() => expect(old.endStroke).toHaveBeenCalledTimes(1));
+    rerenderAs(mounted, "Bar", { ...props, editSession: next });
+    fireEvent.mouseDown(mounted.canvas, at(1, 0));
+    await act(async () => {});
+    expect(next.beginStroke).not.toHaveBeenCalled(); // waits behind the old visit's held end
+    await act(async () => end.resolve());
+    await waitFor(() => expect(next.beginStroke).toHaveBeenCalledTimes(1));
+  });
+
+  it("begin failure: queued moves do not paint after it, and end still follows", async () => {
+    const begin = held();
+    const s = session({ beginStroke: vi.fn(() => begin.promise) });
+    const { canvas } = mount({ editSession: s, activeTool: { kind: "pencil", stamp: STAMP } });
+    fireEvent.mouseDown(canvas, at(0, 0));
+    await waitFor(() => expect(s.beginStroke).toHaveBeenCalledTimes(1));
+    fireEvent.mouseMove(canvas, { ...at(1, 0), buttons: 1 });
+    fireEvent.mouseUp(canvas, at(1, 0));
+    await act(async () => begin.reject(new Error("held begin failed")));
+    expect(s.applyPaint).not.toHaveBeenCalled();
+    expect(s.endStroke).toHaveBeenCalledTimes(1);
+  });
+
+  it("apply failure: a later queued apply still runs and end waits for it", async () => {
+    const first = held();
+    const second = held();
+    const s = session({ applyPaint: vi.fn().mockImplementationOnce(() => first.promise).mockImplementationOnce(() => second.promise) });
+    const { canvas } = mount({ editSession: s, activeTool: { kind: "pencil", stamp: STAMP } });
+    fireEvent.mouseDown(canvas, at(0, 0));
+    await waitFor(() => expect(s.applyPaint).toHaveBeenCalledTimes(1));
+    fireEvent.mouseMove(canvas, { ...at(1, 0), buttons: 1 });
+    fireEvent.mouseUp(canvas, at(1, 0));
+    await act(async () => first.reject(new Error("held apply failed")));
+    expect(s.applyPaint).toHaveBeenCalledTimes(2);
+    expect(s.endStroke).not.toHaveBeenCalled();
+    await act(async () => second.resolve());
+    expect(s.endStroke).toHaveBeenCalledTimes(1);
+  });
+
+  it("an off-map mousedown followed by a held move creates no apply or end without begin", async () => {
+    const s = session();
+    const { canvas } = mount({ editSession: s, activeTool: { kind: "pencil", stamp: STAMP } });
+    fireEvent.mouseDown(canvas, { clientX: 60, clientY: 60, button: 0 });
+    fireEvent.mouseMove(canvas, { ...at(0, 0), buttons: 1 });
+    fireEvent.mouseUp(canvas, at(0, 0));
+    await act(async () => {});
+    expect(s.beginStroke).not.toHaveBeenCalled();
+    expect(s.applyPaint).not.toHaveBeenCalled();
+    expect(s.endStroke).not.toHaveBeenCalled();
+  });
+});
diff --git a/packages/ui/test/gbc/GbcMapCanvasStroke.test.tsx b/packages/ui/test/gbc/GbcMapCanvasStroke.test.tsx
new file mode 100644
index 0000000..eb39be2
--- /dev/null
+++ b/packages/ui/test/gbc/GbcMapCanvasStroke.test.tsx
@@ -0,0 +1,95 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { render, fireEvent, act, waitFor } from "@testing-library/react";
+import { GbcMapCanvas, type GbcMapCanvasProps } from "../../src/gbc/GbcMapCanvas.js";
+import type { UseGbcEditSessionResult } from "../../src/gbc/hooks/useGbcEditSession.js";
+import type { GbcMapPayload } from "@pokemap/core/src/gbc/wire.js";
+import type { GbcMapEvents } from "@pokemap/core/src/gbc/model/types.js";
+
+// Shared stroke chain (Plan 8 Task 1): lost mouseup (F3/M4) and a throwing error handler (M3) on the GBC canvas.
+// Fixture mirrors GbcMapCanvasEdit.test.tsx: 3x2 blocks, border 1; client (40,40) -> block (0,0), (72,72) -> (1,1).
+const NO_EVENTS: GbcMapEvents = { warps: [], coords: [], bgs: [], objects: [], sceneScripts: [], callbacks: [], objectConsts: [] };
+const BLOCKS = [0, 1, 2, 3, 4, 5].map((metatileId) => ({ metatileId }));
+const DATA: GbcMapPayload = {
+  family: "gbc",
+  map: {
+    name: "M", constName: "M", group: 1, number: 1, width: 3, height: 2, blkPath: "maps/M.blk", tileset: "T",
+    environment: "E", landmark: "L", music: "X", phoneFlag: "0", palette: "P", fishGroup: "0", border: 1, connectionFlags: "0", connections: [],
+  },
+  layout: { blkPath: "maps/M.blk", width: 3, height: 2, writable: true },
+  blocks: BLOCKS,
+  metatileCount: 6,
+  tileset: { constName: "T", name: "T" },
+  collision: Array.from({ length: 6 }, () => ({ tl: 0, tr: 0, bl: 0, br: 0 })),
+  collisionInfo: { "0": { name: "COLL_FLOOR", category: "land", talk: false } },
+  events: NO_EVENTS,
+  defects: [],
+  paddingWidth: 3,
+};
+const STAMP = { width: 1, height: 1, cells: [{ metatileId: 9 }] };
+let log: string[];
+
+function held() {
+  let resolve!: () => void;
+  const promise = new Promise<void>((yes) => { resolve = yes; });
+  return { promise, resolve };
+}
+function session(over: Partial<UseGbcEditSessionResult> = {}): UseGbcEditSessionResult {
+  const note = (n: string) => vi.fn((..._a: unknown[]) => { log.push(n); return Promise.resolve(); });
+  return {
+    blocks: BLOCKS, events: NO_EVENTS, isDirty: false, canUndo: false, canRedo: false,
+    beginStroke: note("begin"), applyPaint: vi.fn((b: { targets?: { x: number }[] }) => { log.push(`apply ${b.targets?.[0]?.x}`); return Promise.resolve(); }) as UseGbcEditSessionResult["applyPaint"],
+    endStroke: note("end"), undo: note("undo"), redo: note("redo"), discard: note("discard"), markClean: vi.fn(),
+    moveEvent: note("move"), addEvent: note("add"), deleteEvent: vi.fn(() => Promise.resolve({ warpRenumberWarnings: [] })),
+    ...over,
+  };
+}
+
+class FakeResizeObserver { observe() {} unobserve() {} disconnect() {} }
+let originalGetContext: typeof HTMLCanvasElement.prototype.getContext;
+beforeEach(() => {
+  log = [];
+  vi.stubGlobal("ResizeObserver", FakeResizeObserver);
+  originalGetContext = HTMLCanvasElement.prototype.getContext;
+  // @ts-expect-error -- narrow test stub
+  HTMLCanvasElement.prototype.getContext = () => ({ imageSmoothingEnabled: true, drawImage() {}, clearRect() {}, getImageData: (_x: number, _y: number, w: number, h: number) => ({ data: new Uint8ClampedArray(w * h * 4), width: w, height: h }), putImageData() {}, save() {}, restore() {}, strokeRect() {} });
+  Object.defineProperty(HTMLElement.prototype, "clientWidth", { value: 160, configurable: true });
+  Object.defineProperty(HTMLElement.prototype, "clientHeight", { value: 128, configurable: true });
+});
+afterEach(() => {
+  HTMLCanvasElement.prototype.getContext = originalGetContext;
+  vi.unstubAllGlobals();
+});
+
+function mount(props: Partial<GbcMapCanvasProps> = {}) {
+  const u = render(<GbcMapCanvas mapName="M" data={DATA} time="day" {...props} />);
+  const canvas = u.container.querySelector("canvas.map-canvas__stage") as HTMLCanvasElement;
+  return { ...u, canvas };
+}
+const at = (x: number, y: number) => ({ clientX: x, clientY: y, button: 0 });
+
+describe("GbcMapCanvas shared stroke chain (Plan 8 Task 1)", () => {
+  it("a lost mouseup: a second mousedown ends the open stroke before the new begin (two undo steps)", async () => {
+    const end = held();
+    const s = session({ endStroke: vi.fn(() => { log.push("end"); return end.promise; }) });
+    const { canvas } = mount({ editSession: s, activeTool: { kind: "pencil", stamp: STAMP } });
+    fireEvent.mouseDown(canvas, at(40, 40));
+    await waitFor(() => expect(log).toEqual(["begin", "apply 0"]));
+    fireEvent.mouseDown(canvas, at(72, 40)); // no mouseup in between
+    await act(async () => {});
+    expect(log).toEqual(["begin", "apply 0", "end"]);
+    await act(async () => end.resolve());
+    await waitFor(() => expect(log).toEqual(["begin", "apply 0", "end", "begin", "apply 1"]));
+  });
+
+  it("a throwing onEditError does not stop the next stroke (M3)", async () => {
+    const onEditError = vi.fn(() => { throw new Error("ui broke"); });
+    const s = session({ beginStroke: vi.fn().mockImplementationOnce(() => { log.push("begin"); return Promise.reject(new Error("boom")); }).mockImplementation(() => { log.push("begin"); return Promise.resolve(); }) });
+    const { canvas } = mount({ editSession: s, activeTool: { kind: "pencil", stamp: STAMP }, onEditError });
+    fireEvent.mouseDown(canvas, at(40, 40));
+    fireEvent.mouseUp(canvas, at(40, 40));
+    await waitFor(() => expect(onEditError).toHaveBeenCalledWith("boom"));
+    fireEvent.mouseDown(canvas, at(72, 40));
+    fireEvent.mouseUp(canvas, at(72, 40));
+    await waitFor(() => expect(log).toEqual(["begin", "end", "begin", "apply 1", "end"]));
+  });
+});
diff --git a/packages/ui/test/shared/useStrokeChain.test.tsx b/packages/ui/test/shared/useStrokeChain.test.tsx
new file mode 100644
index 0000000..13ab669
--- /dev/null
+++ b/packages/ui/test/shared/useStrokeChain.test.tsx
@@ -0,0 +1,243 @@
+import { describe, it, expect, vi } from "vitest";
+import { renderHook, act } from "@testing-library/react";
+import { useStrokeChain, type StrokeSession } from "../../src/shared/useStrokeChain.js";
+
+function held() {
+  let resolve!: () => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<void>((yes, no) => { resolve = yes; reject = no; });
+  return { promise, resolve, reject };
+}
+const flush = () => act(async () => {});
+
+type Held = ReturnType<typeof held>;
+/** A session whose every call is logged and held until the test releases it. */
+function heldSession(log: string[]) {
+  const begins: Held[] = [], applies: Held[] = [], ends: Held[] = [];
+  const session: StrokeSession<number> = {
+    beginStroke() { const h = held(); begins.push(h); log.push("begin"); return h.promise; },
+    applyPaint(b: number) { const h = held(); applies.push(h); log.push(`apply:${b}`); return h.promise; },
+    endStroke() { const h = held(); ends.push(h); log.push("end"); return h.promise; },
+  };
+  return { session, begins, applies, ends };
+}
+
+function setup(visitKey = "A", onError: (m: string) => void = () => {}) {
+  return renderHook(({ k }) => useStrokeChain<number>(k, onError), { initialProps: { k: visitKey } });
+}
+
+describe("useStrokeChain", () => {
+  it("runs begin, each apply round trip, then end, strictly in order", async () => {
+    const log: string[] = [];
+    const s = heldSession(log);
+    const { result } = setup();
+    act(() => { result.current.start(s.session, 1); result.current.queue(2); result.current.queue(3); result.current.finish(4); });
+    await flush();
+    expect(log).toEqual(["begin"]);
+    await flush(); s.begins[0]!.resolve(); await flush();
+    expect(log).toEqual(["begin", "apply:1"]);
+    await flush(); s.applies[0]!.resolve(); await flush();
+    expect(log).toEqual(["begin", "apply:1", "apply:2"]);
+    await flush(); s.applies[1]!.resolve(); await flush();
+    expect(log).toEqual(["begin", "apply:1", "apply:2", "apply:3"]);
+    await flush(); s.applies[2]!.resolve(); await flush();
+    expect(log).toEqual(["begin", "apply:1", "apply:2", "apply:3", "apply:4"]);
+    await flush(); s.applies[3]!.resolve(); await flush();
+    expect(log).toEqual(["begin", "apply:1", "apply:2", "apply:3", "apply:4", "end"]);
+    await flush(); s.ends[0]!.resolve(); await flush();
+    expect(result.current.isOpen()).toBe(false);
+  });
+
+  it("a null first and null last issue only begin and end", async () => {
+    const log: string[] = [];
+    const s = heldSession(log);
+    const { result } = setup();
+    act(() => { result.current.start(s.session, null); result.current.finish(null); });
+    await flush();
+    await flush(); s.begins[0]!.resolve(); await flush();
+    expect(log).toEqual(["begin", "end"]);
+  });
+
+  it("the next stroke begin waits for the previous end", async () => {
+    const log: string[] = [];
+    const s = heldSession(log);
+    const { result } = setup();
+    act(() => { result.current.start(s.session, null); result.current.finish(null); });
+    await flush(); s.begins[0]!.resolve(); await flush();
+    act(() => { result.current.start(s.session, null); });
+    await flush();
+    expect(log).toEqual(["begin", "end"]);
+    await flush(); s.ends[0]!.resolve(); await flush();
+    expect(log).toEqual(["begin", "end", "begin"]);
+  });
+
+  it("a lost mouseup: start while open ends the old stroke before the new begin", async () => {
+    const log: string[] = [];
+    const s = heldSession(log);
+    const { result } = setup();
+    act(() => { result.current.start(s.session, 1); });
+    await flush(); s.begins[0]!.resolve(); await flush();
+    await flush(); s.applies[0]!.resolve(); await flush();
+    act(() => { result.current.start(s.session, 2); });
+    await flush();
+    expect(log).toEqual(["begin", "apply:1", "end"]);
+    await flush(); s.ends[0]!.resolve(); await flush();
+    expect(log).toEqual(["begin", "apply:1", "end", "begin"]);
+    expect(result.current.isOpen()).toBe(true);
+  });
+
+  it("queue without an open stroke is a no-op", async () => {
+    const { result } = setup();
+    act(() => { result.current.queue(1); result.current.finish(2); });
+    await flush();
+    expect(result.current.isOpen()).toBe(false);
+  });
+
+  describe("retirement", () => {
+    type R = ReturnType<typeof setup>;
+    const retire: Record<string, (r: R) => void> = {
+      "map change": (r) => r.rerender({ k: "B" }),
+      "A -> B -> A": (r) => { r.rerender({ k: "B" }); r.rerender({ k: "A" }); },
+      "unmount": (r) => r.unmount(),
+    };
+    for (const [label, go] of Object.entries(retire)) {
+      it(`${label} during begin: nothing paints, the begun stroke still ends, no error`, async () => {
+        const log: string[] = [];
+        const onError = vi.fn();
+        const s = heldSession(log);
+        const r = setup("A", onError);
+        act(() => { r.result.current.start(s.session, 1); r.result.current.queue(2); });
+        await flush();
+        go(r);
+        await flush(); s.begins[0]!.resolve(); await flush();
+        expect(log).toEqual(["begin", "end"]);
+        await flush(); s.ends[0]!.reject(new Error("late")); await flush();
+        expect(onError).not.toHaveBeenCalled();
+      });
+
+      it(`${label} during an apply: queued applies drop, end still issues, no error`, async () => {
+        const log: string[] = [];
+        const onError = vi.fn();
+        const s = heldSession(log);
+        const r = setup("A", onError);
+        act(() => { r.result.current.start(s.session, 1); r.result.current.queue(2); r.result.current.queue(3); });
+        await flush(); s.begins[0]!.resolve(); await flush();
+        go(r);
+        await flush(); s.applies[0]!.reject(new Error("late")); await flush();
+        expect(log).toEqual(["begin", "apply:1", "end"]);
+        expect(onError).not.toHaveBeenCalled();
+      });
+
+      it(`${label} during end: the end is not reported`, async () => {
+        const log: string[] = [];
+        const onError = vi.fn();
+        const s = heldSession(log);
+        const r = setup("A", onError);
+        act(() => { r.result.current.start(s.session, null); r.result.current.finish(null); });
+        await flush(); s.begins[0]!.resolve(); await flush();
+        go(r);
+        await flush(); s.ends[0]!.reject(new Error("late")); await flush();
+        expect(log).toEqual(["begin", "end"]);
+        expect(onError).not.toHaveBeenCalled();
+      });
+    }
+
+    it("a retired stroke whose begin failed issues no end", async () => {
+      const log: string[] = [];
+      const s = heldSession(log);
+      const r = setup();
+      act(() => { r.result.current.start(s.session, 1); });
+      await flush();
+      act(() => r.rerender({ k: "B" }));
+      await flush(); s.begins[0]!.reject(new Error("x")); await flush();
+      expect(log).toEqual(["begin"]);
+    });
+
+    it("a new visit stroke waits behind the retired visit end", async () => {
+      const log: string[] = [];
+      const s = heldSession(log);
+      const r = setup();
+      act(() => { r.result.current.start(s.session, null); });
+      await flush(); s.begins[0]!.resolve(); await flush();
+      act(() => r.rerender({ k: "B" }));
+      act(() => { r.result.current.start(s.session, null); });
+      await flush();
+      expect(log).toEqual(["begin", "end"]);
+      await flush(); s.ends[0]!.resolve(); await flush();
+      expect(log).toEqual(["begin", "end", "begin"]);
+    });
+  });
+
+  describe("errors", () => {
+    it("a begin failure reports once, drops queued applies, and finish still ends", async () => {
+      const log: string[] = [];
+      const onError = vi.fn();
+      const s = heldSession(log);
+      const { result } = setup("A", onError);
+      act(() => { result.current.start(s.session, 1); result.current.queue(2); result.current.finish(3); });
+      await flush(); s.begins[0]!.reject(new Error("no begin")); await flush();
+      expect(log).toEqual(["begin", "end"]);
+      expect(onError).toHaveBeenCalledTimes(1);
+      expect(onError).toHaveBeenCalledWith("no begin");
+    });
+
+    it("an apply failure is reported; later applies still run and end still waits", async () => {
+      const log: string[] = [];
+      const onError = vi.fn();
+      const s = heldSession(log);
+      const { result } = setup("A", onError);
+      act(() => { result.current.start(s.session, 1); result.current.queue(2); result.current.finish(null); });
+      await flush(); s.begins[0]!.resolve(); await flush();
+      await flush(); s.applies[0]!.reject(new Error("bad")); await flush();
+      expect(onError).toHaveBeenCalledWith("bad");
+      expect(log).toEqual(["begin", "apply:1", "apply:2"]);
+      await flush(); s.applies[1]!.resolve(); await flush();
+      expect(log).toEqual(["begin", "apply:1", "apply:2", "end"]);
+    });
+
+    it("a non-Error rejection reports the generic message", async () => {
+      const onError = vi.fn();
+      const s: StrokeSession<number> = { beginStroke: () => Promise.reject("x"), applyPaint: () => Promise.resolve(), endStroke: () => Promise.resolve() };
+      const { result } = setup("A", onError);
+      act(() => { result.current.start(s, null); });
+      await flush();
+      expect(onError).toHaveBeenCalledWith("Paint failed.");
+    });
+
+    it("a throwing onError does not poison the chain (M3)", async () => {
+      const log: string[] = [];
+      const onError = vi.fn(() => { throw new Error("ui broke"); });
+      const bad: StrokeSession<number> = {
+        beginStroke: () => { log.push("begin"); return Promise.reject(new Error("x")); },
+        applyPaint: (b) => { log.push(`apply:${b}`); return Promise.resolve(); },
+        endStroke: () => { log.push("end"); return Promise.resolve(); },
+      };
+      const { result } = setup("A", onError);
+      act(() => { result.current.start(bad, 1); result.current.finish(null); });
+      await flush();
+      expect(onError).toHaveBeenCalled();
+      const good: StrokeSession<number> = {
+        beginStroke: () => { log.push("begin2"); return Promise.resolve(); },
+        applyPaint: (b) => { log.push(`apply2:${b}`); return Promise.resolve(); },
+        endStroke: () => { log.push("end2"); return Promise.resolve(); },
+      };
+      act(() => { result.current.start(good, 7); result.current.finish(null); });
+      await flush();
+      expect(log).toEqual(["begin", "end", "begin2", "apply2:7", "end2"]);
+    });
+  });
+
+  it("settled() waits for a held apply", async () => {
+    const log: string[] = [];
+    const s = heldSession(log);
+    const { result } = setup();
+    act(() => { result.current.start(s.session, 1); });
+    await flush(); s.begins[0]!.resolve(); await flush();
+    let done = false;
+    void result.current.settled().then(() => { done = true; });
+    await flush();
+    expect(done).toBe(false);
+    await flush(); s.applies[0]!.resolve(); await flush();
+    expect(done).toBe(true);
+  });
+});
