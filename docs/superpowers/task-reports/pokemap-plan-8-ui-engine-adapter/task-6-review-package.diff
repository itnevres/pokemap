diff --git a/packages/ui/src/shared/EditingWorkspace.tsx b/packages/ui/src/shared/EditingWorkspace.tsx
new file mode 100644
index 0000000..668bcc9
--- /dev/null
+++ b/packages/ui/src/shared/EditingWorkspace.tsx
@@ -0,0 +1,22 @@
+import type { ComponentType, ReactNode } from "react";
+
+/** The shared editing shell used by both map families. It keeps the body and
+ * canvas in one position while active chrome appears around them. */
+export interface WorkspaceSlots<CanvasProps> {
+  /** Rendered only while active, before the stable body (toolbar, strips, banners). */
+  top: ReactNode;
+  /** Rendered only while active, inside the body after the canvas (inspector / rail). */
+  side: ReactNode;
+  /** Null while there is no map (inactive host before load). */
+  canvasProps: CanvasProps | null;
+  /** The family's own canvas, used when renderCanvas is absent. */
+  Canvas: ComponentType<CanvasProps>;
+}
+
+export function EditingWorkspace<CanvasProps>({ active, top, side, canvasProps, Canvas, renderCanvas }: WorkspaceSlots<CanvasProps> & {
+  active: boolean;
+  renderCanvas?: (canvasProps: CanvasProps | null) => ReactNode;
+}) {
+  const canvas = renderCanvas ? renderCanvas(canvasProps) : canvasProps && <Canvas {...canvasProps} />;
+  return <>{active && top}<div className="app__map-editing-body">{canvas}{active && side}</div></>;
+}
diff --git a/packages/ui/src/shared/useVisit.ts b/packages/ui/src/shared/useVisit.ts
new file mode 100644
index 0000000..4598d8a
--- /dev/null
+++ b/packages/ui/src/shared/useVisit.ts
@@ -0,0 +1,24 @@
+import { useLayoutEffect, useRef, useState } from "react";
+
+/** A committed visit identity shared by the GBA and GBC editing hooks. It
+ * lets each hook retire per-map UI state during render, before children see it. */
+export interface Visit {
+  /** True on the render where `key` changed from the previous visit. */
+  changed: boolean;
+  /** False once this render's visit is no longer committed, including A -> B -> A or unmount. */
+  isCurrent(): boolean;
+}
+
+/** Keeps a visit object stable until its key changes; consumers use it to preserve
+ * their stable canvas/body position while retiring only their visit-scoped state. */
+export function useVisit(key: string | null): Visit {
+  const [visit, setVisit] = useState({ key });
+  const currentVisit = useRef<typeof visit | null>(visit);
+  const changed = visit.key !== key;
+  if (changed) setVisit({ key });
+  useLayoutEffect(() => {
+    currentVisit.current = visit;
+    return () => { currentVisit.current = null; };
+  }, [visit]);
+  return { changed, isCurrent: () => currentVisit.current === visit };
+}
