@@ -0,0 +1,41 @@
+import type React from "react";
+import { ZOOM_LEVELS, type MapView } from "../components/mapView.js";
+import type { WorldContext } from "./useWorldContext.js";
+
+/** The in-context editing overlay, shared by both world canvases. It fills the world viewport box exactly, so the
+ *  chromeless map canvas's stage box equals the world canvas box and the controlled view maps one to one (see
+ *  world/contextView.ts). Module-level on purpose: defining it inside a canvas body would remount it every render. */
+export function WorldContextOverlay({ map, ctx, renderCanvas, onDone }: {
+  map: string;
+  ctx: WorldContext;
+  renderCanvas(view: MapView, onViewChange: (v: MapView) => void): React.ReactNode;
+  onDone(): void;
+}) {
+  const { contextView } = ctx;
+  return (
+    <div ref={ctx.overlayRef} className="world-canvas__context" onDoubleClick={ctx.onOverlayDoubleClick}>
+      <div className="world-canvas__context-dim" aria-hidden="true" />
+      {contextView && renderCanvas(contextView, ctx.onContextViewChange)}
+      <div className="world-canvas__context-bar" role="group" aria-label={`Editing ${map} in place`}>
+        <span className="world-canvas__context-name">{map}</span>
+        <div className="world-canvas__context-zoom" role="group" aria-label="Zoom">
+          {ZOOM_LEVELS.map((z) => (
+            <button
+              key={z}
+              type="button"
+              className="map-canvas__btn"
+              aria-pressed={contextView?.zoom === z}
+              disabled={!contextView}
+              onClick={() => ctx.setContextZoom(z)}
+            >
+              {z}×
+            </button>
+          ))}
+        </div>
+        <button type="button" className="map-canvas__btn" aria-label={`Done editing ${map}`} onClick={onDone}>
+          Done
+        </button>
+      </div>
+    </div>
+  );
+}
diff --git a/packages/ui/src/shared/useBeforeUnloadGuard.ts b/packages/ui/src/shared/useBeforeUnloadGuard.ts
new file mode 100644
index 0000000..82714ee
--- /dev/null
+++ b/packages/ui/src/shared/useBeforeUnloadGuard.ts
@@ -0,0 +1,15 @@
+import { useEffect } from "react";
+
+/** No autosave means a dirty session must never be lost silently at the browser boundary.
+ * Attach only while dirty: a session matching disk is safe to abandon, and an always-on handler would falsely prompt. */
+export function useBeforeUnloadGuard(isDirty: boolean): void {
+  useEffect(() => {
+    if (!isDirty) return;
+    const handler = (e: BeforeUnloadEvent) => {
+      e.preventDefault();
+      e.returnValue = "";
+    };
+    window.addEventListener("beforeunload", handler);
+    return () => window.removeEventListener("beforeunload", handler);
+  }, [isDirty]);
+}
diff --git a/packages/ui/src/shared/useContextEditing.ts b/packages/ui/src/shared/useContextEditing.ts
new file mode 100644
index 0000000..71e5308
--- /dev/null
+++ b/packages/ui/src/shared/useContextEditing.ts
@@ -0,0 +1,72 @@
+import { useEffect, useRef, useState } from "react";
+
+export interface UseContextEditingArgs {
+  selected: string | null;
+  session: { isDirty: boolean; markClean(): void };
+  leave(go: () => void): void;
+  select(map: string): void;
+  openSave(): void;
+  strokeSettled(): Promise<void>;
+}
+
+export interface ContextEditing {
+  contextMap: string | null;
+  tileVersions: Record<string, number>;
+  enter(map: string): void;
+  requestExit(): void;
+  onCommitted(): void;
+  leaveContext(): void;
+}
+
+export function useContextEditing({ selected, session, leave, select, openSave, strokeSettled }: UseContextEditingArgs): ContextEditing {
+  const [contextMap, setContextMap] = useState<string | null>(null);
+  const [tileVersions, setTileVersions] = useState<Record<string, number>>({});
+  const [exitPending, setExitPending] = useState(false);
+  const exitRequested = useRef<object | null>(null);
+  const leaveContext = () => {
+    exitRequested.current = null;
+    setExitPending(false);
+    setContextMap(null);
+  };
+
+  useEffect(() => {
+    if (contextMap !== null && selected !== contextMap) leaveContext();
+  }, [selected, contextMap]);
+
+  // Paint responses update React state: decide on the render after the chain settles, not its old closure.
+  useEffect(() => {
+    if (!exitPending) return;
+    setExitPending(false);
+    exitRequested.current = null;
+    if (contextMap === null || selected !== contextMap) return;
+    if (session.isDirty) openSave();
+    else setContextMap(null);
+  }, [exitPending, session.isDirty, contextMap, selected, openSave]);
+
+  return {
+    contextMap,
+    tileVersions,
+    enter(map) {
+      const go = () => {
+        if (map !== selected) select(map);
+        setContextMap(map);
+      };
+      if (map === selected) go(); else leave(go);
+    },
+    requestExit() {
+      if (exitRequested.current || contextMap === null) return;
+      const request = {};
+      exitRequested.current = request;
+      strokeSettled().then(() => {
+        if (exitRequested.current === request) setExitPending(true);
+      });
+    },
+    onCommitted() {
+      session.markClean();
+      if (contextMap !== null && contextMap === selected) {
+        setTileVersions((t) => ({ ...t, [contextMap]: (t[contextMap] ?? 0) + 1 }));
+      }
+    },
+    leaveContext,
+  };
+}
