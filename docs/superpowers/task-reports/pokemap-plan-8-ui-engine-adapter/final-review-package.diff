+import { useCallback, useRef, useState } from "react";
+
+export interface EditFlags { isDirty: boolean; canUndo: boolean; canRedo: boolean }
+/** An updater lets family hooks merge partial replies without losing other state. */
+export type EditUpdate<State> = { state?: (prev: State) => State } & Partial<EditFlags>;
+export interface EditTicket { readonly map: string; readonly seed: unknown; readonly seq: number }
+export interface EditSessionCore<State> extends EditFlags {
+  state: State;
+  post<R>(path: string, body?: unknown): Promise<{ data: R; ticket: EditTicket } | null>;
+  apply(update: EditUpdate<State>, ticket?: EditTicket): boolean;
+  discard(): Promise<void>;
+  markClean(): void;
+}
+
+interface Stored<State> extends EditFlags {
+  forMap: string | null;
+  seed: State;
+  state: State;
+}
+
+/** Map/seed identity controls the rendered view; tickets order asynchronous replies. */
+export function useEditSessionCore<State>(base: string, mapName: string | null, seed: State, opts?: { readServerError?: boolean }): EditSessionCore<State> {
+  const [stored, setStored] = useState<Stored<State> | null>(null);
+  const latest = useRef({ mapName, seed });
+  latest.current = { mapName, seed };
+  const seq = useRef({ issued: 0, applied: 0 });
+  const readServerError = opts?.readServerError ?? false;
+  const live = stored !== null && stored.forMap === mapName && stored.seed === seed ? stored : null;
+
+  const post = useCallback(async <R,>(path: string, body?: unknown): Promise<{ data: R; ticket: EditTicket } | null> => {
+    if (mapName === null) return null;
+    const ticket: EditTicket = { map: mapName, seed, seq: ++seq.current.issued };
+    const r = await fetch(`${base}/${encodeURIComponent(mapName)}${path}`, body === undefined ? { method: "POST" } : { method: "POST", body: JSON.stringify(body) });
+    // GBC reads even malformed bodies once, then its family shape check owns the failure.
+    const data: unknown = readServerError ? await r.json().catch(() => null) : undefined;
+    if (!r.ok) {
+      const message = data !== null && typeof data === "object" && "error" in data && typeof data.error === "string" ? data.error : `POST ${base}/${mapName}${path} -> ${r.status}`;
+      throw new Error(message);
+    }
+    return { data: (readServerError ? data : await r.json()) as R, ticket };
+  }, [base, mapName, seed, readServerError]);
+
+  const apply = useCallback((update: EditUpdate<State>, ticket?: EditTicket): boolean => {
+    const current = latest.current;
+    if (ticket) {
+      if (current.mapName !== ticket.map || current.seed !== ticket.seed || ticket.seq <= seq.current.applied) return false;
+      seq.current.applied = ticket.seq;
+    }
+    setStored((prev) => {
+      const start = prev !== null && prev.forMap === current.mapName && prev.seed === current.seed
+        ? prev
+        : { forMap: current.mapName, seed: current.seed, state: current.seed, isDirty: false, canUndo: false, canRedo: false };
+      return {
+        ...start,
+        state: update.state ? update.state(start.state) : start.state,
+        isDirty: update.isDirty ?? start.isDirty,
+        canUndo: update.canUndo ?? start.canUndo,
+        canRedo: update.canRedo ?? start.canRedo,
+      };
+    });
+    return true;
+  }, []);
+
+  const discard = useCallback(async () => {
+    if (mapName === null) return;
+    const r = await fetch(`${base}/${encodeURIComponent(mapName)}/discard`, { method: "POST" });
+    if (!r.ok) throw new Error(`POST ${base}/${mapName}/discard -> ${r.status}`);
+    seq.current.applied = seq.current.issued; // in-flight edits cannot resurrect a discarded session
+    setStored((prev) => (prev?.forMap === mapName ? null : prev)); // a switch during the await keeps the new map's record
+  }, [base, mapName]);
+
+  const markClean = useCallback(() => {
+    setStored((prev) => prev === null ? prev : { ...prev, isDirty: false, canUndo: false, canRedo: false });
+  }, []);
+
+  return { state: live ? live.state : seed, isDirty: live?.isDirty ?? false, canUndo: live?.canUndo ?? false, canRedo: live?.canRedo ?? false, post, apply, discard, markClean };
+}
diff --git a/packages/ui/src/shared/useStrokeChain.ts b/packages/ui/src/shared/useStrokeChain.ts
new file mode 100644
index 0000000..3c3c66d
--- /dev/null
+++ b/packages/ui/src/shared/useStrokeChain.ts
@@ -0,0 +1,116 @@
+import { useCallback, useLayoutEffect, useMemo, useRef } from "react";
+
+export interface StrokeSession<Body> {
+  beginStroke(): Promise<void>;
+  applyPaint(body: Body): Promise<unknown>;
+  endStroke(): Promise<void>;
+}
+
+export interface StrokeChain<Body> {
+  /** mousedown: ends any still-open stroke first (F3/M4), then begin, then `first` (if any) as one awaited link. */
+  start(session: StrokeSession<Body>, first: Body | null): void;
+  /** held move: queued behind every earlier link; dropped if the visit retired or begin failed. */
+  queue(body: Body): void;
+  /** mouseup/mouseleave: `last` (rect/shift final apply, or null), then end, after every queued link. */
+  finish(last: Body | null): void;
+  isOpen(): boolean;
+  /** Resolves when every link issued so far has settled. */
+  settled(): Promise<void>;
+}
+
+export type SettledChain = Pick<StrokeChain<unknown>, "settled">;
+
+export function useStrokeChainRegistry(): { onStrokeChain(chain: SettledChain, mounted: boolean): void; strokeSettled(): Promise<void> } {
+  const chains = useRef(new Set<SettledChain>());
+  const onStrokeChain = useCallback((chain: SettledChain, mounted: boolean) => {
+    if (mounted) chains.current.add(chain); else chains.current.delete(chain);
+  }, []);
+  const strokeSettled = useCallback(() => Promise.all([...chains.current].map((chain) => chain.settled())).then(() => {}), []);
+  return { onStrokeChain, strokeSettled };
+}
+
+interface Stroke<Body> {
+  visit: object;
+  begun: boolean;
+  session: StrokeSession<Body>;
+}
+
+/**
+ * One completion chain for begin, every apply and end, so no request in a stroke outruns its predecessor (B1,
+ * moved out of GbcMapCanvas). `visitKey` = the map name: a change or unmount retires the visit, so queued work
+ * drops and a begun stroke still ends on its captured session; errors of a retired visit are not reported.
+ */
+export function useStrokeChain<Body>(visitKey: string, onError: (message: string) => void): StrokeChain<Body> {
+  const tailRef = useRef<Promise<void>>(Promise.resolve());
+  const visitRef = useRef<object>({});
+  const strokeRef = useRef<Stroke<Body> | null>(null);
+  const onErrorRef = useRef(onError);
+  onErrorRef.current = onError;
+
+  useLayoutEffect(() => {
+    visitRef.current = {};
+    return () => {
+      visitRef.current = {};
+      const stroke = strokeRef.current;
+      strokeRef.current = null;
+      if (stroke) {
+        tailRef.current = tailRef.current.then(async () => {
+          if (stroke.begun) await stroke.session.endStroke();
+        }).catch(() => {}); // The retired visit cannot display a late error.
+      }
+    };
+  }, [visitKey]);
+
+  return useMemo<StrokeChain<Body>>(() => {
+    const owns = (stroke: Stroke<Body>) => stroke.visit === visitRef.current;
+    const report = (stroke: Stroke<Body>, e: unknown) => {
+      if (!owns(stroke)) return;
+      try { onErrorRef.current(e instanceof Error ? e.message : "Paint failed."); } catch { /* a throwing handler must not skip the end (M3) */ }
+    };
+    /** Append a link. The terminal catch keeps a throwing onError from rejecting (poisoning) the chain (M3). */
+    const append = (stroke: Stroke<Body>, link: () => Promise<unknown> | void) => {
+      tailRef.current = tailRef.current
+        .then(link)
+        .catch((e) => report(stroke, e))
+        .catch(() => {})
+        .then(() => {});
+    };
+    const finish = (last: Body | null) => {
+      const stroke = strokeRef.current;
+      if (!stroke) return;
+      strokeRef.current = null;
+      append(stroke, async () => {
+        if (!owns(stroke) && !stroke.begun) return;
+        if (last !== null && owns(stroke) && stroke.begun) {
+          await stroke.session.applyPaint(last).catch((e) => report(stroke, e)); // a rejected apply must not leave the stroke open
+        }
+        // A retired visit stops queued paint but still finishes an issued stroke on its captured session.
+        await stroke.session.endStroke();
+      });
+    };
+    return {
+      start(session, first) {
+        finish(null); // lost mouseup: the old stroke ends before the new begin
+        const stroke: Stroke<Body> = { visit: visitRef.current, begun: false, session };
+        strokeRef.current = stroke;
+        append(stroke, async () => {
+          if (!owns(stroke)) return;
+          await session.beginStroke();
+          stroke.begun = true;
+          if (!owns(stroke) || first === null) return;
+          await session.applyPaint(first);
+        });
+      },
+      queue(body) {
+        const stroke = strokeRef.current;
+        if (!stroke) return;
+        append(stroke, () => {
+          if (owns(stroke) && stroke.begun) return stroke.session.applyPaint(body);
+        });
+      },
+      finish,
+      isOpen: () => strokeRef.current !== null,
+      settled: () => tailRef.current.then(() => {}),
+    };
+  }, []);
+}
diff --git a/packages/ui/src/shared/useVisit.ts b/packages/ui/src/shared/useVisit.ts
new file mode 100644
index 0000000..8e3a0db
--- /dev/null
+++ b/packages/ui/src/shared/useVisit.ts
@@ -0,0 +1,24 @@
+import { useLayoutEffect, useRef, useState } from "react";
+
+/** A committed visit identity shared by the GBA and GBC editing hooks. It
+ * lets each hook retire per-map UI state during render, before children see it. */
+export interface Visit {
+  /** True on the render where `key` changed from the previous visit. */
+  changed: boolean;
+  /** False once this render's visit is no longer committed, including A -> B -> A or unmount. */
+  isCurrent(): boolean;
+}
+
+/** Stable until `key` changes; `changed` is true for exactly the render that
+ * changes it, and `isCurrent` retires callbacks once that visit is replaced. */
+export function useVisit(key: string | null): Visit {
+  const [visit, setVisit] = useState({ key });
+  const currentVisit = useRef<typeof visit | null>(visit);
+  const changed = visit.key !== key;
+  if (changed) setVisit({ key });
+  useLayoutEffect(() => {
+    currentVisit.current = visit;
+    return () => { currentVisit.current = null; };
+  }, [visit]);
+  return { changed, isCurrent: () => currentVisit.current === visit };
+}
diff --git a/packages/ui/src/shared/useWorldContext.ts b/packages/ui/src/shared/useWorldContext.ts
new file mode 100644
index 0000000..cd33093
--- /dev/null
+++ b/packages/ui/src/shared/useWorldContext.ts
@@ -0,0 +1,133 @@
+import { useEffect, useRef, useState } from "react";
+import type React from "react";
+import { ZOOM_LEVELS, zoomAboutPivot, type MapView, type Zoom } from "../components/mapView.js";
+import { enterContextView, mapViewFromWorld, snapContextZoom, worldViewFromMapView } from "../world/contextView.js";
+
+export interface ContextPlacement { x: number; y: number; width: number; height: number }
+
+export interface UseWorldContextArgs {
+  /** World px per unit at 1x: 16 (GBA tile) or 32 (GBC block). Required, no default. */
+  native: number;
+  context: { map: string; origin: { x: number; y: number } | null; onExitRequest(): void } | null;
+  /** null unless the context map is placed with width > 0 && height > 0. */
+  placement: ContextPlacement | null;
+  world: { pan: { x: number; y: number }; zoom: number; setView(v: { pan: { x: number; y: number }; zoom: number }): void };
+  /** Pivot for setContextZoom (its centre). */
+  viewport: { w: number; h: number };
+  /** The box for the pointer at snap time; the focus target on exit. */
+  canvasRef: React.RefObject<HTMLCanvasElement | null>;
+  /** Client px recorded by the host before entering; read and cleared at snap. */
+  snapPointerRef: React.MutableRefObject<{ x: number; y: number } | null>;
+  /** Family-specific: its context menu is open (it closes on its own window listener). */
+  isBlocked(): boolean;
+}
+
+export interface WorldContext {
+  inContext: boolean;
+  contextView: MapView | null;
+  onContextViewChange(next: MapView): void;
+  setContextZoom(z: Zoom): void;
+  /** Keyboard +/-: toward `direction` from the nearest level (a wheel can leave a non-level zoom). No-op outside a snapped context. */
+  stepZoom(direction: 1 | -1): void;
+  overlayRef: React.RefObject<HTMLDivElement | null>;
+  onOverlayDoubleClick(e: React.MouseEvent<HTMLDivElement>): void;
+  maxWorldZoom(base: number): number;
+}
+
+/** In-context editing of one world map, shared by the GBA and GBC world canvases (`native` is the per-family parameter). */
+export function useWorldContext(args: UseWorldContextArgs): WorldContext {
+  const { native, context, placement, world, viewport, canvasRef, snapPointerRef } = args;
+  const inContext = context !== null;
+  const contextName = context?.map ?? null;
+  const contextOrigin = context?.origin ?? null;
+  const hasOrigin = contextOrigin !== null;
+
+  // Snap once per entry: the context map's centre goes to the recorded pointer (canvas centre if none), at the nearest
+  // of 1x/2x/4x. It waits for `context.origin` (the map's layout): the host mounts its editing chrome in that same
+  // commit, which moves and resizes this canvas, so the pointer (client px) is converted with the canvas box as it is
+  // NOW, not as it was at the click. `snappedFor` gates the overlay canvas so it never mounts at the pre-snap zoom.
+  // The ref is the same-tick guard (a StrictMode double run must not snap twice); one setView, never nested. Leaving
+  // context hands focus back to the canvas (the Done button unmounts).
+  const snappedForRef = useRef<string | null>(null);
+  const [snappedFor, setSnappedFor] = useState<string | null>(null);
+  useEffect(() => {
+    if (contextName === null) {
+      if (snappedForRef.current !== null) canvasRef.current?.focus();
+      snappedForRef.current = null;
+      setSnappedFor(null);
+      return;
+    }
+    if (!hasOrigin || snappedForRef.current === contextName || !placement) return;
+    const canvas = canvasRef.current;
+    if (!canvas) return;
+    snappedForRef.current = contextName;
+    const box = canvas.getBoundingClientRect();
+    const client = snapPointerRef.current;
+    snapPointerRef.current = null;
+    const next = enterContextView({
+      placement: { x: placement.x, y: placement.y, width: placement.width, height: placement.height },
+      pointer: client ? { x: client.x - box.left, y: client.y - box.top } : { x: canvas.clientWidth / 2, y: canvas.clientHeight / 2 },
+      zoom: snapContextZoom(world.zoom, native),
+      native,
+    });
+    world.setView(next);
+    setSnappedFor(contextName);
+    // eslint-disable-next-line react-hooks/exhaustive-deps -- zoom is read at entry only; the ref guard above is what governs re-entry.
+  }, [contextName, placement?.x, placement?.y, placement?.width, placement?.height, hasOrigin]);
+
+  // Exits: Escape (a window listener in the CAPTURE phase, only while in context). Capture runs before every bubble
+  // handler, so what it checks is still the DOM the key press found: SaveDialog, WarpDestinationModal and SignComposer
+  // close on Escape from a React handler without stopping propagation (and React may flush that unmount before a
+  // bubble listener on window ran), and the context menu closes on its own window listener. Skipped when another
+  // handler already took the key (defaultPrevented), when a context menu or a modal dialog is open, and when the key
+  // came from a text field (those use Escape locally).
+  const onExitRequestRef = useRef(context?.onExitRequest);
+  onExitRequestRef.current = context?.onExitRequest;
+  const isBlockedRef = useRef(args.isBlocked);
+  isBlockedRef.current = args.isBlocked;
+  useEffect(() => {
+    if (!inContext) return;
+    const onKeyDown = (e: KeyboardEvent) => {
+      if (e.key !== "Escape" || e.defaultPrevented || isBlockedRef.current() || document.querySelector('[aria-modal="true"]')) return;
+      if (e.target instanceof Element && e.target.closest('input, textarea, select, [contenteditable=""], [contenteditable="true"]')) return;
+      onExitRequestRef.current?.();
+    };
+    window.addEventListener("keydown", onKeyDown, true);
+    return () => window.removeEventListener("keydown", onKeyDown, true);
+  }, [inContext]);
+
+  // The overlay's controlled map view: the world's own pan/zoom, expressed in the composite's frame.
+  const contextView =
+    snappedFor === contextName && placement && contextOrigin
+      ? mapViewFromWorld({ placement, worldPan: world.pan, worldZoom: world.zoom, originX: contextOrigin.x, originY: contextOrigin.y, native })
+      : null;
+  const onContextViewChange = (next: MapView) => {
+    if (!placement || !contextOrigin) return;
+    world.setView(worldViewFromMapView({ placement, view: next, originX: contextOrigin.x, originY: contextOrigin.y, native }));
+  };
+  const setContextZoom = (z: Zoom) => {
+    if (!contextView) return;
+    const next = zoomAboutPivot(contextView, z, viewport.w / 2, viewport.h / 2);
+    if (next !== contextView) onContextViewChange(next);
+  };
+  const stepZoom = (direction: 1 | -1) => {
+    if (!contextView) return;
+    const z = contextView.zoom;
+    const target =
+      direction === 1
+        ? (ZOOM_LEVELS.find((l) => l > z) ?? ZOOM_LEVELS[ZOOM_LEVELS.length - 1]!)
+        : ([...ZOOM_LEVELS].reverse().find((l) => l < z) ?? ZOOM_LEVELS[0]);
+    setContextZoom(target);
+  };
+  const overlayRef = useRef<HTMLDivElement>(null);
+  const onOverlayDoubleClick = (e: React.MouseEvent<HTMLDivElement>) => {
+    if ((e.target as Element).closest(".world-canvas__context-bar") || !placement || !overlayRef.current) return;
+    const rect = overlayRef.current.getBoundingClientRect();
+    const sx = e.clientX - rect.left, sy = e.clientY - rect.top;
+    const x0 = placement.x * world.zoom + world.pan.x, y0 = placement.y * world.zoom + world.pan.y;
+    const inside = sx >= x0 && sx < x0 + placement.width * world.zoom && sy >= y0 && sy < y0 + placement.height * world.zoom;
+    if (!inside) context?.onExitRequest();
+  };
+
+  return { inContext, contextView, onContextViewChange, setContextZoom, stepZoom, overlayRef, onOverlayDoubleClick, maxWorldZoom: (base) => (inContext ? base * 4 : base) };
+}
